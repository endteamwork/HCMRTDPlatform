# Copy to .env and fill in. .env is gitignored — never commit it.

# --- AWS ---
AWS_REGION=eu-north-1
S3_BUCKET=data-hackathon-smit-ali

# --- USAJOBS (https://developer.usajobs.gov/) ---
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your-registered-email@example.com

# --- Open Exchange Rates (https://openexchangerates.org/) ---
OER_APP_ID=
OER_BASE_CURRENCY=USD
OER_SYMBOLS=PKR,SAR,AED,GBP,EUR,INR

# --- BLS (no key needed for scraping; optional Public Data API key slot) ---
BLS_API_KEY=

# --- Snowflake (used to create the hcm/snowflake secret for the Glue job) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DB=HCM
SNOWFLAKE_SCHEMA=JOBS

# --- SQL Server (filled automatically when RDS is created) ---
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DB=hcm
